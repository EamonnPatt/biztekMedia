# biztekmedia.ca sits inside another site's folder (an addon domain). Rewrite rules set here
# replace that site's WordPress rules, which would otherwise apply too and turn every missing
# page into a 500 error. The only rule this site needs: send http:// visits to https://,
# so the checkout page is never served over an insecure connection.
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
DirectoryIndex index.html

# Browsers check for a newer copy of the pages, scripts and styles on every visit (unchanged
# files cost a tiny "not modified" reply), so a deploy shows up straight away instead of
# visitors seeing an old cached version of the studio or its prices.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
